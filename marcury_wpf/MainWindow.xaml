<Window x:Class="marcury_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:marcury_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="630" Width="1000">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Button search, and final confirm -->
            <RowDefinition Height="30"/>
            <!-- Height DataGrid -->
            <RowDefinition Height="300"/>
            <!-- Height Button -->
            <RowDefinition Height="50"/>
            <!-- Height TextBox -->
            <RowDefinition Height="180"/>
            <!-- Height StatusBar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row ="0" Margin="0.1,0,0,0.5" Width="980" Background="#7B7B7B">
            <Label x:Name="label" Content="　設定　ヘルプ" Height="30" Width="152" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0"/>
            <Button x:Name="BtnSearchText" Content="クリップボードのテキストで検索" Width="160" Height="25" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="700,0,0,0"/>
            <Button x:Name="BtnFinalConfir" Content="最終確認" Width="110" Height="26" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0"/>
        </Grid>
        <DataGrid Grid.Row="1" x:Name="dgMarcuryEx" AutoGenerateColumns="False" Margin="10,24,22,0">
            <DataGrid.Columns>
                <!-- Type CheckBox -->
                <DataGridTemplateColumn Header="Column1" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- type String -->
                <DataGridTextColumn Header="Column2" Width="300" Binding="{Binding Column2}" />
                <DataGridTextColumn Header="Column3" Width="150" Binding="{Binding Column3}" />

                <!-- type CheckBox -->
                <DataGridTemplateColumn Header="Column4" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Type String -->
                <DataGridTextColumn Header="Column5" Width="300" Binding="{Binding Column5}" />
                <DataGridTextColumn Header="Column6" Width="150" Binding="{Binding Column6}" />

                <!-- Type CheckBox -->
                <DataGridTemplateColumn Header="Column7" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Column8" Width="300" Binding="{Binding Column8}" />
                <DataGridTextColumn Header="Column9" Width="150" Binding="{Binding Column9}" />
                <DataGridTextColumn Header="Column10" Width="150" Binding="{Binding Column10}" />
                <DataGridTextColumn Header="Column11" Width="150" Binding="{Binding Column11}" />

                <!-- Type CheckBox -->
                <DataGridTemplateColumn Header="Column12" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Column13" Width="150" Binding="{Binding Column13}" />
                <DataGridTextColumn Header="Column14" Width="150" Binding="{Binding Column14}" />

                <!-- Type Image -->
                <DataGridTemplateColumn Header="Column15" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageSource}" Width="50" Height="50" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Column16" Width="300" Binding="{Binding Column16}" />
                <DataGridTextColumn Header="Column17" Width="300" Binding="{Binding Column17}" />
            </DataGrid.Columns>
        </DataGrid>
        <!-- Loading Animation -->
        <Viewbox Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
         x:Name="LoadingContainer" Visibility="Collapsed">
            <Grid Width="12.5" Height="12.5">
                <!-- Rotating dots -->
                <Ellipse Width="0.5" Height="0.5" Fill="LightBlue" Opacity="0.3">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" CenterX="1" CenterY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="0.5" Height="0.5" Fill="SkyBlue" Opacity="0.5" Canvas.Left="3.75" Canvas.Top="0">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="45" CenterX="1" CenterY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="0.5" Height="0.5" Fill="DodgerBlue" Opacity="0.7" Canvas.Left="6.25" Canvas.Top="3.75">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="90" CenterX="1" CenterY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="0.5" Height="0.5" Fill="DeepSkyBlue" Opacity="0.9" Canvas.Left="3.75" Canvas.Top="7.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="135" CenterX="1" CenterY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="0.5" Height="0.5" Fill="White" Opacity="1" Canvas.Left="0" Canvas.Top="3.75">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="180" CenterX="1" CenterY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Viewbox>

        <Button Grid.Row="2" x:Name="BtnSearchHandle" Content="Search Text" HorizontalAlignment="Left" Margin="12,10,0,0" VerticalAlignment="Top" Click="BtnSearchHandle_Click" Width="111" RenderTransformOrigin="0.367,0.747"/>
        <TextBox Grid.Row="2" x:Name="TbxResult" Margin="2,50,0,0" TextWrapping="Wrap" Text="TextBox" Width="966" Height="161" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.RowSpan="2"/>
        <StatusBar Grid.Row="4" Name="barStatus" 
           VerticalAlignment="Top" Background="Beige" Margin="0,2,0,0" >
            <StatusBarItem Name="SbiVersion" MouseDown="SbiVersion_MouseDown">
                <TextBlock Text="{StaticResource VERSION}"></TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="100" Height="20"
                 Name="progressBar1">
                    <ProgressBar.Triggers>
                        <EventTrigger RoutedEvent="ProgressBar.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                Storyboard.TargetName="progressBar1" 
                Storyboard.TargetProperty="Value"
                From="0" To="100" Duration="0:0:5"  />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ProgressBar.Triggers>
                </ProgressBar>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Name="tbxStatus">Online</TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Left">
                <Image Source="Images\help.png" Width="16" Height="16"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
